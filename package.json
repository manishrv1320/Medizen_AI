{
  "name": "medizen",
  "version": "1.0.0",
  "description": "Personal health checkup dashboard with family sharing, reminders, notifications and a personal health assistant",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
