# Copy this file to .env and fill in what you need.

# Port for the web server
PORT=3000

# Optional: your Google Gemini API key (from https://aistudio.google.com/apikey) for the
# full conversational AI assistant. Medizen uses ONLY this key, never GEMINI_API_KEY /
# GOOGLE_API_KEY or any other key set on the computer.
# Without it, the assistant still works using built-in rules.
MEDIZEN_GEMINI_API_KEY=

# Optional: Gemini model for the assistant (default gemini-3.8-flash, which has a free tier).
# gemini-3.5-flash-lite is faster and cheaper on the paid tier.
# GEMINI_MODEL=gemini-3.8-flash

# Set to "production" when serving over HTTPS (marks cookies Secure)
NODE_ENV=development
